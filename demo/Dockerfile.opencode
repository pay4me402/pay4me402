FROM ubuntu:24.04

# Install basic runtime requirements
RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Pre-install the opencode CLI during the image build
RUN curl -fsSL https://opencode.ai/install | bash

EXPOSE 9000

# Download the CA certificate from the proxy, trust it, and start the server at runtime
ENTRYPOINT ["/bin/bash", "-c", "curl -o /usr/local/share/ca-certificates/payformeproxy-ca.crt http://proxy:8080/ca.crt; update-ca-certificates ; exec /root/.opencode/bin/opencode serve --hostname 0.0.0.0 --port 9000"]
